{
  "name": "relay-studio",
  "version": "1.1.1",
  "description": "Local-first visual automation for desktop files and optional AI",
  "main": "build/main.cjs",
  "author": "Yaqoubj",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:installer": "npm run dist:win",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "server": "tsx src/server/server.ts",
    "test:server": "tsx --test tests/server.test.ts"
  },
  "build": {
    "appId": "com.yaqoubj.relaystudio",
    "productName": "Relay Studio",
    "files": [
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/relay.svg",
      "target": [
        "nsis"
      ],
      "artifactName": "Relay-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relay Studio"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/sensible": "^6.0.5",
    "@xyflow/react": "^12.11.6",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.47.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
